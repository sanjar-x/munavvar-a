# ==============================================================================
# КОНФИГУРАЦИЯ
# ==============================================================================
# Путь к docker-compose файлу для локальной разработки
COMPOSE_DEV = deploy/compose.dev.yml

# ==============================================================================
# ПОМОЩЬ И ДОКУМЕНТАЦИЯ
# ==============================================================================
.PHONY: help
help: ## Показать этот экран помощи
	@echo "Доступные команды:"
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2}'

# ==============================================================================
# ИНФРАСТРУКТУРА (DOCKER)
# ==============================================================================
.PHONY: up
up: ## Поднять локальную базу данных (PostgreSQL) в фоне
	docker compose -f $(COMPOSE_DEV) up -d

.PHONY: down
down: ## Остановить и удалить локальные контейнеры
	docker compose -f $(COMPOSE_DEV) down

.PHONY: logs-db
logs-db: ## Посмотреть логи базы данных
	docker compose -f $(COMPOSE_DEV) logs -f

# ==============================================================================
# РАЗРАБОТКА И ЗАПУСК
# ==============================================================================
.PHONY: dev
dev: ## Запустить локальный сервер FastAPI с горячей перезагрузкой
	uv run fastapi dev src/main.py

.PHONY: sync
sync: ## Синхронизировать зависимости (установить новые пакеты)
	uv sync

# ==============================================================================
# БАЗА ДАННЫХ И МИГРАЦИИ (ALEMBIC)
# ==============================================================================
.PHONY: migrate
migrate: ## Создать новую миграцию (Использование: make migrate m="название")
	@if [ -z "$(m)" ]; then echo "Ошибка: Укажите сообщение миграции, например: make migrate m=\"init_users\""; exit 1; fi
	uv run alembic revision --autogenerate -m "$(m)"

.PHONY: upgrade
upgrade: ## Применить все новые миграции к базе данных
	uv run alembic upgrade head

.PHONY: downgrade
downgrade: ## Откатить последнюю миграцию
	uv run alembic downgrade -1

# ==============================================================================
# КАЧЕСТВО КОДА (LINTERS & FORMATTERS)
# ==============================================================================
.PHONY: format
format: ## Отформатировать код с помощью Ruff
	uv run ruff format .
	uv run ruff check --fix .

.PHONY: lint
lint: ## Проверить код линтером без внесения изменений
	uv run ruff check .

# ==============================================================================
# ТЕСТИРОВАНИЕ
# ==============================================================================
.PHONY: test
test: ## Запустить все тесты
	uv run pytest -v